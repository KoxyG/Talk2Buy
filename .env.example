# Core agent and comparison: Muse Spark 1.3 and Muse Wonder on Meta Model API (OpenAI-compatible)
META_API_KEY=
META_BASE_URL=
SPARK_MODEL_ID=muse-spark-1.3      # standard ID, not contributor
WONDER_MODEL_ID=muse-wonder-1.0
VOICE_MODEL_ID=          # Muse Voice Transcribe; confirm at kickoff
IMAGE_MODEL_ID=          # Muse Image 1.0; confirm at kickoff

# Comparison: Muse Spark Open (Meta open weights) on Baseten, hackathon credits
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
SPARK_OPEN_MODEL_ID=meta-models/muse-spark-open-1026   # the hackathon key only works with this ID

# Database (Supabase, read-only product snapshot)
DATABASE_URL=

# Domains serving the /embed page, comma-separated (production: talk2buy.vercel.app)
EMBED_HOSTS=localhost

# Pidgin/slang fallback lookup (only used when the glossary has no match)
BRAVE_SEARCH_API_KEY=

# Landing page contact form (apps/demo): Resend API key and the inbox that receives requests
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# WhatsApp channel (Meta Cloud API): access token, app secret (checks webhook signatures) and the
# verify token entered with the webhook URL
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
